{{- /* Full directory dataset for client-side rendering: the /saved/ page (see
      static/js/saved-directories.js's buildCard()), the table search box, and the filter
      modal's Ahrefs DR / monthly visitors range filters (see static/js/directory-tabs.js's
      buildRow() and applyFilters()). Keep the fields in sync with all three. */ -}}
{{- $items := slice -}}
{{- with site.GetPage "directory" -}}
  {{- range .RegularPages.ByTitle -}}
    {{- $categories := slice -}}
    {{- range .Params.categories -}}
      {{- with site.GetPage (printf "/category/%s" .) -}}
        {{- $categories = $categories | append (dict
          "slug" .File.ContentBaseName
          "title" .Title
          "url" .RelPermalink
          "icon" (partial "category-icon.html" .)
        ) -}}
      {{- end -}}
    {{- end -}}
    {{- $founded := .Params.founded | time.AsTime -}}
    {{- $items = $items | append (dict
      "slug" .File.ContentBaseName
      "title" .Title
      "url" .RelPermalink
      "website" .Params.website
      "description" .Params.description
      "ahrefs_dr" .Params.ahrefs_dr
      "monthly_visitors" .Params.monthly_visitors
      "founded" ($founded.Format "2006-01-02")
      "pricing" .Params.pricing
      "categories" $categories
    ) -}}
  {{- end -}}
{{- end -}}
{{ jsonify $items }}
